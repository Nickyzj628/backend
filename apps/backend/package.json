  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/app.ts",
    "build": "esbuild src/app.ts --bundle --platform=node --target=node25 --outdir=dist --format=esm --packages=external --minify --alias:@=./src",
    "build:prod": "esbuild src/app.ts --bundle --platform=node --target=node25 --outdir=dist-prod --format=esm --packages=external --minify --alias:@=./src",
    "start:prod": "node --env-file=.env dist-prod/app.js",
    "start": "node --env-file=.env dist/app.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@nickyzj/shared-types": "workspace:*",
    "@nickyzj2023/utils": "^1.0.59",
    "chokidar": "^5.0.0",
    "hono": "^4.12.8",
    "marked": "^17.0.5",
    "pinyin-pro": "^3.28.0",
    "shiki": "^4.0.2",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0"
  }
}
