{
	"name": "nickyzj-monorepo",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.5.0",
	"scripts": {
		"dev:backend": "pnpm --filter backend dev",
		"dev:frontend": "pnpm --filter frontend dev",
		"dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,green\"",
		"build:backend": "pnpm --filter backend build",
		"build:frontend:dev": "pnpm --filter frontend build:dev",
		"build:frontend:prod": "pnpm --filter frontend build:prod",
		"build:frontend": "pnpm build:frontend:dev",
		"build": "pnpm build:backend && pnpm build:frontend",
		"check": "pnpm dlx @biomejs/biome check .",
		"check:write": "pnpm dlx @biomejs/biome check --write .",
		"test": "pnpm --filter backend test && pnpm --filter frontend test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.1",
		"@types/node": "^22.13.5",
		"concurrently": "^9.2.1"
	}
}
